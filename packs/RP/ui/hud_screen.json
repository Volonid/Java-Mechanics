{
    "namespace": "hud",
    "hud_title_text/title_frame/title": {
        "modifications": [
            {
                "array_name": "bindings",
                "operation": "insert_back",
                "value": {
                    "binding_type": "view",
                    "source_property_name": "(not (('%.13s' * #text) = '_javamechanics:'))",
                    "target_property_name": "#visible"
                }
            }
        ]
    },
    "hotbar_end_cap": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "cooldown_hotbar@javamechanics.cooldown_hotbar": {
                            "$update_string": "_javamechanics:"
                        }
                    }
                ]
            }
        ]
    },
    "root_panel": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "cooldown_bar_element_on_crosshair": {
                            "type": "panel",
                            "size": ["16px", "16px"],
                            "controls": [{ "cooldown_ui@javamechanics.cooldown_ui": {} }]
                        }
                    }
                ]
            }
        ]
    }
}
